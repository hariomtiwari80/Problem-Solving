class Solution {
    public int subarraySum(int[] arr, int k) {
        int n=arr.length;
        HashMap<Integer,Integer> map=new HashMap<>();
        map.put(0,1);
        int pre=0;
        int c=0;
        for(int i=0;i<n;i++){
            pre+=arr[i];
            if(map.containsKey(pre-k)){
                c+=map.get(pre-k);
            }
            map.put(pre,map.getOrDefault(pre,0)+1);
        }
        return c;
    }
}
